# Database — sqlite for dev, postgres for prod (see scripts/use-postgres.mjs)
DATABASE_URL="file:./dev.db"
# Example for postgres:
# DATABASE_URL="postgresql://user:pass@localhost:5432/dealism"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# First admin account (seeded via `npm run db:seed`)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="strongpassword"

# Optional defaults — most settings are managed in /admin/settings UI now
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Background-job queue (BullMQ). Leave empty to run jobs inline.
REDIS_URL=""

# Error + performance monitoring (Sentry). Optional.
SENTRY_DSN=""

# Daily backups (S3-compatible: AWS, Wasabi, B2, R2, MinIO).
# Used by `npm run backup` script (cron it in production).
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
BACKUP_S3_REGION="auto"
BAILEYS_AUTH_DIR=""
