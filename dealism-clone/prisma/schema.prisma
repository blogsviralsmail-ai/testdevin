generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          String    @default("user") // "user" | "admin"
  plan          String    @default("trial") // "trial" | "monthly_basic" | "monthly_pro" | "annual" | "enterprise"
  trialEndsAt   DateTime?
  conversationsUsed Int   @default(0)
  conversationsQuota Int  @default(100)
  // Currently-selected workspace for the dashboard. Falls back to the
  // user's personal workspace when null.
  activeWorkspaceId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agents        Agent[]
  channels      Channel[]
  conversations Conversation[]
  knowledgeItems KnowledgeItem[]
  workspacesOwned Workspace[]   @relation("WorkspaceOwner")
  memberships   Membership[]
}

// Team collaboration. Every user gets a personal workspace at signup;
// owners can invite teammates with assigned roles. Resources (Agents,
// Channels, KnowledgeItems, Conversations) belong to the workspace, so
// when one teammate adds an Agent every other member can see/use it.
model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User           @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]
  agents      Agent[]
  channels    Channel[]
  conversations Conversation[]
  knowledgeItems KnowledgeItem[]
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // "owner" | "admin" | "member"
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Invitation {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("member")
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Agent {
  id            String   @id @default(cuid())
  userId        String   // Creator (kept for audit / personal workspace)
  workspaceId   String?  // The workspace this resource belongs to.
  name          String
  description   String?
  systemPrompt  String   // Agent personality / instructions
  tone          String?  // "professional" | "friendly" | "casual"
  language      String   @default("en")
  isActive      Boolean  @default(true)
  model         String   @default("gpt-4o-mini")
  temperature   Float    @default(0.7)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels      Channel[]
  conversations Conversation[]
  knowledgeItems KnowledgeItem[]

  @@index([workspaceId])
}

model Channel {
  id            String   @id @default(cuid())
  userId        String   // Creator
  workspaceId   String?
  agentId       String?
  type          String   // "whatsapp" | "telegram" | "messenger" | "line" | "viber" | "discord"
  name          String
  phoneNumber   String?
  status        String   @default("disconnected") // "connected" | "disconnected" | "connecting"
  sessionData   String?  // encrypted Baileys session
  qrCode        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent         Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([workspaceId])
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String   // Creator
  workspaceId   String?
  agentId       String?
  channelId     String?
  contactName   String?
  contactNumber String?
  contactAvatar String?
  status        String   @default("active") // "active" | "closed" | "needs_human"
  lastMessageAt DateTime @default(now())
  isAutoReply   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent         Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  channel       Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([workspaceId])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  role            String   // "user" | "assistant" | "system"
  content         String
  attachmentUrl   String?
  metadata        String?  // JSON string
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model KnowledgeItem {
  id          String   @id @default(cuid())
  userId      String   // Creator
  workspaceId String?
  agentId     String?
  title       String
  content     String
  sourceType  String   // "text" | "url" | "file" | "faq"
  sourceUrl   String?
  embedding   String?  // JSON array of floats
  createdAt   DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general") // "api" | "general" | "pricing" | "branding"
  updatedAt DateTime @updatedAt
}

model Plan {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  priceMonthly        Float
  priceAnnual         Float?
  conversationsQuota  Int
  features            String   // JSON array
  isPopular           Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
}

/// Records every Razorpay payment we've already applied so retries
/// (webhook re-deliveries, manual replays of /api/billing/verify)
/// can't reset conversationsUsed or re-upgrade the same purchase.
/// Keyed by paymentId because Razorpay re-uses orderId for retries
/// of the same checkout but always issues a fresh paymentId on
/// successful capture.
model ProcessedPayment {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  orderId     String
  userId      String
  planSlug    String
  source      String   // "verify" | "webhook"
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}
