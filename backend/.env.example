# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database (MySQL - same as existing Laravel database)
DATABASE_URL="mysql://root:password@localhost:3306/wabapanel"

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Session
SESSION_SECRET=your-session-secret-key

# Redis (for BullMQ queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp (Meta) - configured per vendor via settings
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=WabaPanel

# Payment Gateways
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYSTACK_SECRET_KEY=your-paystack-secret
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt
YOOMONEY_WALLET_ID=your-yoomoney-wallet

# File Storage
UPLOAD_PATH=./storage/app/public
MAX_FILE_SIZE=52428800

# License
LICENSE_KEY=your-panel-license-key
