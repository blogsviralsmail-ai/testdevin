generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id                 Int       @id @default(autoincrement()) @map("_id")
  uid                String    @unique @map("_uid") @db.VarChar(36)
  email              String    @db.VarChar(255)
  password           String    @db.VarChar(255)
  first_name         String?   @db.VarChar(150)
  last_name          String?   @db.VarChar(150)
  user_roles_id      Int?      @map("user_roles__id")
  vendors_id         Int?      @map("vendors__id")
  status             Int?      @default(1)
  remember_token     String?   @db.VarChar(255)
  two_factor_enabled Int?      @default(0)
  two_factor_code    String?   @db.VarChar(10)
  email_verified_at  DateTime?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt

  @@index([email])
  @@index([vendors_id])
}

model vendors {
  id         Int       @id @default(autoincrement()) @map("_id")
  uid        String    @unique @map("_uid") @db.VarChar(36)
  title      String?   @db.VarChar(255)
  slug       String?   @db.VarChar(255)
  status     Int?      @default(1)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  @@index([uid])
  @@index([slug])
}

model vendor_settings {
  id          Int     @id @default(autoincrement()) @map("_id")
  uid         String? @map("_uid") @db.VarChar(36)
  vendors_id  Int     @map("vendors__id")
  name        String  @db.VarChar(255)
  value       String? @db.LongText

  @@unique([vendors_id, name], name: "vendors__id_name")
  @@index([vendors_id])
}

model contacts {
  id              Int       @id @default(autoincrement()) @map("_id")
  uid             String    @unique @map("_uid") @db.VarChar(36)
  vendors_id      Int       @map("vendors__id")
  first_name      String?   @db.VarChar(150)
  last_name       String?   @db.VarChar(150)
  wa_id           String?   @db.VarChar(50)
  email           String?   @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  country         String?   @db.VarChar(100)
  status          Int?      @default(1)
  unread_count    Int?      @default(0)
  last_message_at DateTime?
  created_at      DateTime? @default(now())
  updated_at      DateTime? @updatedAt

  @@index([vendors_id])
  @@index([wa_id])
}

model contact_groups {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  title       String?   @db.VarChar(255)
  description String?   @db.Text
  status      Int?      @default(1)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  @@index([vendors_id])
}

model group_contact_assigns {
  id                 Int     @id @default(autoincrement()) @map("_id")
  uid                String? @map("_uid") @db.VarChar(36)
  contact_groups_id  Int?    @map("contact_groups__id")
  contacts_id        Int?    @map("contacts__id")

  @@index([contact_groups_id])
  @@index([contacts_id])
}

model labels {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  title       String?   @db.VarChar(255)
  text_color  String?   @db.VarChar(50)
  status      Int?      @default(1)
  created_at  DateTime? @default(now())

  @@index([vendors_id])
}

model contact_labels {
  id           Int     @id @default(autoincrement()) @map("_id")
  uid          String? @map("_uid") @db.VarChar(36)
  contacts_id  Int?    @map("contacts__id")
  labels_id    Int?    @map("labels__id")
  vendors_id   Int?    @map("vendors__id")

  @@index([contacts_id])
  @@index([labels_id])
}

model whatsapp_message_logs {
  id                   Int       @id @default(autoincrement()) @map("_id")
  uid                  String    @unique @map("_uid") @db.VarChar(36)
  vendors_id           Int?      @map("vendors__id")
  contacts_id          Int?      @map("contacts__id")
  message              String?   @db.LongText
  message_type         String?   @db.VarChar(50)
  is_incoming_message  Int?      @default(0)
  whatsapp_message_id  String?   @db.VarChar(255)
  status               String?   @db.VarChar(50)
  messaged_at          DateTime?
  phone_number_id      String?   @db.VarChar(100)
  media_url            String?   @db.Text
  campaigns_id         Int?      @map("campaigns__id")

  @@index([vendors_id])
  @@index([contacts_id])
  @@index([whatsapp_message_id])
  @@index([messaged_at])
}

model whatsapp_templates {
  id            Int       @id @default(autoincrement()) @map("_id")
  uid           String    @unique @map("_uid") @db.VarChar(36)
  vendors_id    Int       @map("vendors__id")
  template_id   String?   @db.VarChar(100)
  template_name String?   @db.VarChar(255)
  language      String?   @db.VarChar(50)
  category      String?   @db.VarChar(100)
  status        String?   @db.VarChar(50)
  components    String?   @db.LongText
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  @@unique([vendors_id, template_id], name: "vendors__id_template_id")
  @@index([vendors_id])
}

model campaigns {
  id                      Int       @id @default(autoincrement()) @map("_id")
  uid                     String    @unique @map("_uid") @db.VarChar(36)
  vendors_id              Int       @map("vendors__id")
  name                    String?   @db.VarChar(255)
  whatsapp_templates_id   Int?      @map("whatsapp_templates__id")
  status                  String?   @db.VarChar(50)
  scheduled_at            DateTime?
  started_at              DateTime?
  completed_at            DateTime?
  total_count             Int?      @default(0)
  sent_count              Int?      @default(0)
  failed_count            Int?      @default(0)
  created_at              DateTime? @default(now())
  updated_at              DateTime? @updatedAt

  @@index([vendors_id])
}

model campaign_logs {
  id            Int       @id @default(autoincrement()) @map("_id")
  uid           String?   @map("_uid") @db.VarChar(36)
  campaigns_id  Int?      @map("campaigns__id")
  contacts_id   Int?      @map("contacts__id")
  status        String?   @db.VarChar(50)
  message_id    String?   @db.VarChar(255)
  error         String?   @db.Text
  created_at    DateTime? @default(now())

  @@index([campaigns_id])
}

model bot_replies {
  id            Int       @id @default(autoincrement()) @map("_id")
  uid           String    @unique @map("_uid") @db.VarChar(36)
  vendors_id    Int       @map("vendors__id")
  name          String?   @db.VarChar(255)
  keyword       String?   @db.VarChar(255)
  match_type    String?   @db.VarChar(50)
  reply_message String?   @db.LongText
  reply_type    String?   @db.VarChar(50)
  priority      Int?      @default(0)
  status        Int?      @default(1)
  trigger_count Int?      @default(0)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  @@index([vendors_id])
}

model bot_flows {
  id            Int       @id @default(autoincrement()) @map("_id")
  uid           String    @unique @map("_uid") @db.VarChar(36)
  vendors_id    Int       @map("vendors__id")
  name          String?   @db.VarChar(255)
  trigger_type  String?   @db.VarChar(50)
  trigger_value String?   @db.VarChar(255)
  flow_data     String?   @db.LongText
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  @@index([vendors_id])
}

model whatsapp_forms {
  id                   Int       @id @default(autoincrement()) @map("_id")
  uid                  String    @unique @map("_uid") @db.VarChar(36)
  vendors_id           Int?      @map("vendors__id")
  title                String?   @db.VarChar(255)
  description          String?   @db.Text
  fields               String?   @db.LongText
  confirmation_message String?   @db.Text
  status               Int?      @default(1)
  created_at           DateTime? @default(now())
  updated_at           DateTime? @updatedAt

  @@index([vendors_id])
}

model whatsapp_form_responses {
  id                 Int       @id @default(autoincrement()) @map("_id")
  uid                String    @unique @map("_uid") @db.VarChar(36)
  whatsapp_forms_id  Int?      @map("whatsapp_forms__id")
  vendors_id         Int?      @map("vendors__id")
  response_data      String?   @db.LongText
  created_at         DateTime? @default(now())

  @@index([whatsapp_forms_id])
}

model whatsapp_flows {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  flow_id     String?   @db.VarChar(100)
  name        String?   @db.VarChar(255)
  status      String?   @db.VarChar(50)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  @@index([vendors_id])
}

model subscriptions {
  id                     Int       @id @default(autoincrement()) @map("_id")
  uid                    String    @unique @map("_uid") @db.VarChar(36)
  vendors_id             Int?      @map("vendors__id")
  subscription_plans_id  Int?      @map("subscription_plans__id")
  plan_name              String?   @db.VarChar(255)
  price                  Decimal?  @db.Decimal(10, 2)
  status                 String?   @db.VarChar(50)
  payment_method         String?   @db.VarChar(100)
  expiry_at              DateTime?
  created_at             DateTime? @default(now())
  updated_at             DateTime? @updatedAt

  @@index([vendors_id])
}

model subscription_plans {
  id            Int       @id @default(autoincrement()) @map("_id")
  uid           String    @unique @map("_uid") @db.VarChar(36)
  name          String?   @db.VarChar(255)
  price         Decimal?  @db.Decimal(10, 2)
  duration_days Int?
  features      String?   @db.LongText
  status        Int?      @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
}

model login_logs {
  id           Int       @id @default(autoincrement()) @map("_id")
  uid          String    @unique @map("_uid") @db.VarChar(36)
  users_id     Int?      @map("users__id")
  ip_address   String?   @db.VarChar(50)
  user_agent   String?   @db.Text
  logged_in_at DateTime?

  @@index([users_id])
}

model site_settings {
  id    Int     @id @default(autoincrement()) @map("_id")
  uid   String? @map("_uid") @db.VarChar(36)
  name  String? @unique @db.VarChar(255)
  value String? @db.LongText
}

model preset_messages {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  title       String?   @db.VarChar(255)
  message     String?   @db.LongText
  type        String?   @db.VarChar(50)
  buttons     String?   @db.LongText
  media_url   String?   @db.Text
  status      Int?      @default(1)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  @@index([vendors_id])
}

model drip_campaigns {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  name        String?   @db.VarChar(255)
  steps       String?   @db.LongText
  status      Int?      @default(1)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  @@index([vendors_id])
}

model auto_followups {
  id                     Int       @id @default(autoincrement()) @map("_id")
  uid                    String    @unique @map("_uid") @db.VarChar(36)
  vendors_id             Int       @map("vendors__id")
  name                   String?   @db.VarChar(255)
  trigger_after_hours    Int?
  message                String?   @db.LongText
  whatsapp_templates_id  Int?      @map("whatsapp_templates__id")
  status                 Int?      @default(1)
  created_at             DateTime? @default(now())

  @@index([vendors_id])
}

model birthday_wishes {
  id                     Int       @id @default(autoincrement()) @map("_id")
  uid                    String    @unique @map("_uid") @db.VarChar(36)
  vendors_id             Int       @map("vendors__id")
  name                   String?   @db.VarChar(255)
  message                String?   @db.LongText
  whatsapp_templates_id  Int?      @map("whatsapp_templates__id")
  status                 Int?      @default(1)
  created_at             DateTime? @default(now())

  @@index([vendors_id])
}

model feedback_surveys {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  name        String?   @db.VarChar(255)
  questions   String?   @db.LongText
  status      Int?      @default(1)
  created_at  DateTime? @default(now())

  @@index([vendors_id])
}

model pages {
  id               Int       @id @default(autoincrement()) @map("_id")
  uid              String    @unique @map("_uid") @db.VarChar(36)
  title            String?   @db.VarChar(255)
  slug             String?   @db.VarChar(255)
  content          String?   @db.LongText
  meta_title       String?   @db.VarChar(255)
  meta_description String?   @db.Text
  status           Int?      @default(1)
  created_at       DateTime? @default(now())
  updated_at       DateTime? @updatedAt

  @@index([slug])
}

model blog_articles {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  title       String?   @db.VarChar(255)
  slug        String?   @db.VarChar(255)
  content     String?   @db.LongText
  category    String?   @db.VarChar(100)
  status      Int?      @default(1)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  @@index([slug])
}

model payment_links {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  title       String?   @db.VarChar(255)
  amount      Decimal?  @db.Decimal(10, 2)
  currency    String?   @db.VarChar(10)
  gateway     String?   @db.VarChar(50)
  status      String?   @db.VarChar(50)
  payment_url String?   @db.Text
  created_at  DateTime? @default(now())

  @@index([vendors_id])
}

model product_catalogs {
  id          Int       @id @default(autoincrement()) @map("_id")
  uid         String    @unique @map("_uid") @db.VarChar(36)
  vendors_id  Int       @map("vendors__id")
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  price       Decimal?  @db.Decimal(10, 2)
  image_url   String?   @db.Text
  category    String?   @db.VarChar(100)
  status      Int?      @default(1)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  @@index([vendors_id])
}

model translations {
  id         Int     @id @default(autoincrement()) @map("_id")
  uid        String? @map("_uid") @db.VarChar(36)
  locale     String? @db.VarChar(10)
  group_name String? @db.VarChar(100)
  key        String? @db.VarChar(255)
  value      String? @db.LongText

  @@index([locale, group_name])
}
