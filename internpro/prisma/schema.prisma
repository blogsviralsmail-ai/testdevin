generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  password      String
  role          String    @default("student")
  avatar        String?
  isActive      Boolean   @default(true)
  resetToken    String?
  resetExpiry   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Student-specific profile fields
  collegeName   String?
  degree        String?
  year          String?
  address       String?
  dob           DateTime?

  organization    Organization? @relation("OrgAdmin")
  enrollments     Enrollment[]
  submissions     Submission[]
  leaderBatches   Batch[]         @relation("BatchLeader")
  notifications   Notification[]
  attendances     Attendance[]
  documents       Document[]
  interviews      Interview[]
  employeeCards   EmployeeCard[]
  supportTickets  SupportTicket[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("company")
  logo        String?
  description String?
  website     String?
  address     String?
  phone       String?
  adminId     String   @unique
  admin       User     @relation("OrgAdmin", fields: [adminId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programs    Program[]
}

model Program {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  domain        String
  mode          String   @default("online")
  duration      Int
  feeType       String   @default("free")
  feeAmount     Float    @default(0)
  stipendAmount Float    @default(0)
  maxSeats      Int      @default(50)
  thumbnail     String?
  isPublished   Boolean  @default(false)
  totalDays     Int      @default(30)
  weekoffs      String   @default("sunday")
  workingHours  String?
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches       Batch[]
}

model Batch {
  id          String   @id @default(cuid())
  name        String
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  leaderId    String?
  leader      User?    @relation("BatchLeader", fields: [leaderId], references: [id])
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  tasks       Task[]
  resources   Resource[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  fileUrl   String
  status    String   @default("pending")
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interview {
  id            String   @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
  scheduledAt   DateTime
  duration      Int      @default(30)
  mode          String   @default("online")
  meetLink      String?
  location      String?
  interviewerId String
  interviewer   User     @relation(fields: [interviewerId], references: [id])
  status        String   @default("scheduled")
  feedback      String?
  rating        Int?
  result        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])
  status      String   @default("applied")
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Selection details (filled by admin after interview)
  salary        Float?
  weekoffs      Int?
  paidLeaves    Int?
  workTiming    String?
  joiningDate   DateTime?
  feeType       String?
  feeAmount     Float?
  stipendAmount Float?

  // Completion
  teamLeaderCategory String?
  teamLeaderRemarks  String?
  adminApproved      Boolean  @default(false)
  adminRemarks       String?

  // Working day tracking
  currentWorkDay Int      @default(0)

  attendances    Attendance[]
  certificates   Certificate[]
  payments       Payment[]
  salaries       Salary[]
  interviews     Interview[]
  offerLetter    OfferLetter?
  experienceLetter ExperienceLetter?

  @@unique([studentId, batchId])
}

model OfferLetter {
  id           String   @id @default(cuid())
  enrollmentId String   @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  letterNumber String   @unique
  htmlContent  String?
  templateId   String?
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
}

model OfferLetterTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("offer")
  htmlContent String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExperienceLetter {
  id           String   @id @default(cuid())
  enrollmentId String   @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  letterNumber String   @unique
  category     String
  htmlContent  String?
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
}

model EmployeeCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cardNumber  String   @unique
  designation String
  department  String?
  validFrom   DateTime
  validUntil  DateTime
  photoUrl    String?
  qrCode      String?
  createdAt   DateTime @default(now())
}

model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  date         DateTime
  status       String   @default("present")
  workDay      Int?
  checkIn      String?
  checkOut     String?
  method       String   @default("manual")
  ipAddress    String?
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([enrollmentId, date])
}

model Task {
  id          String   @id @default(cuid())
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])
  title       String
  description String?
  type        String   @default("regular")
  dayNumber   Int?
  dueDate     DateTime?
  maxPoints   Int      @default(100)
  resources   String?
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  scope       String   @default("all")
  assignedTo  String?
  isUrgent    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
}

model Submission {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  content     String?
  fileUrl     String?
  percentage  Float?
  feedback    String?
  reviewedBy  String?
  status      String   @default("submitted")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([taskId, studentId])
}

model Certificate {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  certNumber   String   @unique
  type         String   @default("completion")
  studentName  String
  programName  String
  orgName      String
  issueDate    DateTime @default(now())
  qrCode       String?
  templateData String?
  createdAt    DateTime @default(now())
}

model Payment {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  amount       Float
  type         String   @default("fee")
  status       String   @default("pending")
  paymentId    String?
  method       String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Salary {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  month        String
  amount       Float
  attendanceDays Int
  totalDays    Int
  status       String   @default("pending")
  paidAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([enrollmentId, month])
}

model Resource {
  id          String   @id @default(cuid())
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])
  title       String
  type        String   @default("video")
  url         String
  dayNumber   Int?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  message   String
  priority  String   @default("normal")
  status    String   @default("open")
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
