generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  phone           String?
  password        String
  role            String              @default("student")
  avatar          String?
  isActive        Boolean             @default(true)
  resetToken      String?
  resetExpiry     DateTime?
  employeeId      String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  collegeName     String?
  degree          String?
  year            String?
  address         String?
  dob             DateTime?
  state           String?
  bio             String?
  skills          String?
  linkedinUrl     String?
  portfolioUrl    String?
  agentProfile    Agent?              @relation("AgentProfile")
  announcements   Announcement[]      @relation("Announcements")
  attendances     Attendance[]
  leaderBatches   Batch[]             @relation("BatchLeader")
  documents       Document[]
  employeeCards   EmployeeCard[]
  enrollments     Enrollment[]
  points          GamificationPoint[] @relation("UserPoints")
  interviews      Interview[]
  jobApplications JobApplication[]    @relation("JobApplications")
  loginSessions   LoginSession[]
  notifications   Notification[]
  organization    Organization?       @relation("OrgAdmin")
  quizAttempts    QuizAttempt[]       @relation("QuizAttempts")
  referredBy      Referral[]          @relation("ReferredBy")
  submissions     Submission[]
  supportTickets  SupportTicket[]
  badges          UserBadge[]         @relation("UserBadges")
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("company")
  logo        String?
  description String?
  website     String?
  address     String?
  phone       String?
  adminId     String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  admin       User      @relation("OrgAdmin", fields: [adminId], references: [id])
  programs    Program[]
}

model Program {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String?
  domain        String
  mode          String       @default("online")
  duration      Int
  feeType       String       @default("free")
  feeAmount     Float        @default(0)
  stipendAmount Float        @default(0)
  maxSeats      Int          @default(50)
  thumbnail     String?
  isPublished   Boolean      @default(false)
  totalDays     Int          @default(30)
  weekoffs      String       @default("sunday")
  workingHours  String?
  orgId         String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  batches       Batch[]
  organization  Organization @relation(fields: [orgId], references: [id])
}

model Batch {
  id          String       @id @default(cuid())
  name        String
  programId   String
  leaderId    String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  leader      User?        @relation("BatchLeader", fields: [leaderId], references: [id])
  program     Program      @relation(fields: [programId], references: [id])
  enrollments Enrollment[]
  resources   Resource[]
  tasks       Task[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  fileUrl   String
  status    String   @default("pending")
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Interview {
  id            String     @id @default(cuid())
  enrollmentId  String
  scheduledAt   DateTime
  duration      Int        @default(30)
  mode          String     @default("online")
  meetLink      String?
  location      String?
  interviewerId String
  status        String     @default("scheduled")
  feedback      String?
  rating        Int?
  result        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  interviewer   User       @relation(fields: [interviewerId], references: [id])
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
}

model Enrollment {
  id                 String            @id @default(cuid())
  studentId          String
  batchId            String
  status             String            @default("applied")
  enrolledAt         DateTime          @default(now())
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  salary             Float?
  weekoffs           Int?
  paidLeaves         Int?
  workTiming         String?
  joiningDate        DateTime?
  feeType            String?
  feeAmount          Float?
  stipendAmount      Float?
  teamLeaderCategory String?
  teamLeaderRemarks  String?
  adminApproved      Boolean           @default(false)
  adminRemarks       String?
  preferredMode      String?
  paymentStatus      String            @default("not_required")
  currentWorkDay     Int               @default(0)
  attendances        Attendance[]
  certificates       Certificate[]
  batch              Batch             @relation(fields: [batchId], references: [id])
  student            User              @relation(fields: [studentId], references: [id])
  experienceLetter   ExperienceLetter?
  interviews         Interview[]
  offerLetter        OfferLetter?
  payments           Payment[]
  salaries           Salary[]

  @@unique([studentId, batchId])
}

model OfferLetter {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  letterNumber String     @unique
  htmlContent  String?
  templateId   String?
  issuedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
}

model OfferLetterTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("offer")
  htmlContent String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExperienceLetter {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  letterNumber String     @unique
  category     String
  htmlContent  String?
  issuedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
}

model EmployeeCard {
  id          String   @id @default(cuid())
  userId      String
  cardNumber  String   @unique
  designation String
  department  String?
  validFrom   DateTime
  validUntil  DateTime
  photoUrl    String?
  qrCode      String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Attendance {
  id           String     @id @default(cuid())
  enrollmentId String
  userId       String
  date         DateTime
  status       String     @default("present")
  workDay      Int?
  checkIn      String?
  checkOut     String?
  method       String     @default("manual")
  ipAddress    String?
  notes        String?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, date])
}

model Task {
  id          String       @id @default(cuid())
  batchId     String
  title       String
  description String?
  type        String       @default("regular")
  dayNumber   Int?
  dueDate     DateTime?
  maxPoints   Int          @default(100)
  resources   String?
  isPublished Boolean      @default(true)
  order       Int          @default(0)
  scope       String       @default("all")
  assignedTo  String?
  isUrgent    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
  batch       Batch        @relation(fields: [batchId], references: [id])
}

model Submission {
  id         String   @id @default(cuid())
  taskId     String
  studentId  String
  content    String?
  fileUrl    String?
  percentage Float?
  feedback   String?
  reviewedBy String?
  status     String   @default("submitted")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    User     @relation(fields: [studentId], references: [id])
  task       Task     @relation(fields: [taskId], references: [id])

  @@unique([taskId, studentId])
}

model Certificate {
  id           String     @id @default(cuid())
  enrollmentId String
  certNumber   String     @unique
  type         String     @default("completion")
  studentName  String
  programName  String
  orgName      String
  issueDate    DateTime   @default(now())
  qrCode       String?
  templateData String?
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
}

model Payment {
  id           String     @id @default(cuid())
  enrollmentId String
  amount       Float
  type         String     @default("fee")
  status       String     @default("pending")
  paymentId    String?
  method       String?
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
}

model Salary {
  id             String     @id @default(cuid())
  enrollmentId   String
  month          String
  amount         Float
  attendanceDays Int
  totalDays      Int
  status         String     @default("pending")
  paidAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, month])
}

model Resource {
  id          String   @id @default(cuid())
  batchId     String
  title       String
  type        String   @default("video")
  url         String
  fileUrl     String?
  dayNumber   Int?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  batch       Batch    @relation(fields: [batchId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  priority  String   @default("normal")
  status    String   @default("open")
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model LoginSession {
  id           String   @id @default(cuid())
  userId       String
  date         String
  loginTime    String
  logoutTime   String?
  totalMinutes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model GamificationPoint {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  category  String   @default("task")
  createdAt DateTime @default(now())
  user      User     @relation("UserPoints", fields: [userId], references: [id])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String      @default("🏆")
  category    String      @default("achievement")
  threshold   Int         @default(0)
  createdAt   DateTime    @default(now())
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id])
  user     User     @relation("UserBadges", fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model Quiz {
  id           String         @id @default(cuid())
  title        String
  description  String?
  batchId      String?
  programId    String?
  dayNumber    Int?
  timeLimit    Int?
  passingScore Int            @default(60)
  isPublished  Boolean        @default(false)
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  attempts     QuizAttempt[]
  questions    QuizQuestion[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  options       String
  correctAnswer Int
  points        Int      @default(10)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  answers     String
  score       Float
  totalPoints Int
  passed      Boolean   @default(false)
  timeTaken   Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation("QuizAttempts", fields: [userId], references: [id])
  quiz        Quiz      @relation(fields: [quizId], references: [id])

  @@unique([quizId, userId])
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  content    String
  category   String   @default("general")
  isPinned   Boolean  @default(false)
  authorId   String
  targetRole String   @default("all")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation("Announcements", fields: [authorId], references: [id])
}

model JobPosting {
  id           String           @id @default(cuid())
  title        String
  company      String
  description  String
  location     String?
  salary       String?
  type         String           @default("full-time")
  skills       String?
  applyUrl     String?
  isActive     Boolean          @default(true)
  postedBy     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id        String     @id @default(cuid())
  jobId     String
  userId    String
  resume    String?
  coverNote String?
  status    String     @default("applied")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation("JobApplications", fields: [userId], references: [id])
  job       JobPosting @relation(fields: [jobId], references: [id])

  @@unique([jobId, userId])
}

model Agent {
  id             String        @id @default(cuid())
  userId         String        @unique
  referralCode   String        @unique
  commissionRate Float         @default(30)
  totalEarnings  Float         @default(0)
  walletBalance  Float         @default(0)
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  upiId          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation("AgentProfile", fields: [userId], references: [id])
  payouts        AgentPayout[]
  referrals      Referral[]
}

model Referral {
  id         String   @id @default(cuid())
  agentId    String
  studentId  String
  programId  String?
  amount     Float    @default(0)
  commission Float    @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    User     @relation("ReferredBy", fields: [studentId], references: [id])
  agent      Agent    @relation(fields: [agentId], references: [id])
}

model AgentPayout {
  id         String   @id @default(cuid())
  agentId    String
  amount     Float
  method     String   @default("manual")
  status     String   @default("pending")
  razorpayId String?
  reference  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agent      Agent    @relation(fields: [agentId], references: [id])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  content     String
  rating      Int      @default(5)
  avatar      String?
  videoUrl    String?
  isPublished Boolean  @default(true)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Discussion {
  id         String            @id @default(cuid())
  batchId    String?
  programId  String?
  authorId   String
  title      String
  content    String
  category   String            @default("doubt")
  isPinned   Boolean           @default(false)
  isResolved Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  replies    DiscussionReply[]
}

model DiscussionReply {
  id           String     @id @default(cuid())
  discussionId String
  authorId     String
  content      String
  isAnswer     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
}

model LiveSession {
  id           String   @id @default(cuid())
  title        String
  description  String?
  batchId      String?
  programId    String?
  hostId       String
  meetLink     String?
  platform     String   @default("google_meet")
  scheduledAt  DateTime
  duration     Int      @default(60)
  status       String   @default("scheduled")
  recordingUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailCampaign {
  id          String    @id @default(cuid())
  title       String
  subject     String
  htmlContent String
  targetRole  String    @default("all")
  status      String    @default("draft")
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  openCount   Int       @default(0)
  clickCount  Int       @default(0)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String?
  roomId     String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  isPublished Boolean @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id           String     @id @default(cuid())
  userId       String
  enrollmentId String?
  leaveType    String     @default("casual")
  startDate    DateTime
  endDate      DateTime
  totalDays    Float      @default(1)
  reason       String
  status       String     @default("pending")
  approvedBy   String?
  adminRemarks String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Holiday {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  type        String   @default("public")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payslip {
  id             String   @id @default(cuid())
  salaryId       String
  enrollmentId   String
  userId         String
  month          String
  year           Int
  basicPay       Float    @default(0)
  allowances     Float    @default(0)
  deductions     Float    @default(0)
  bonus          Float    @default(0)
  netPay         Float    @default(0)
  workingDays    Int      @default(0)
  presentDays    Int      @default(0)
  leaveDays      Int      @default(0)
  paymentMethod  String?
  paymentRef     String?
  paidAt         DateTime?
  status         String   @default("generated")
  htmlContent    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([enrollmentId, month, year])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  displayName String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}
